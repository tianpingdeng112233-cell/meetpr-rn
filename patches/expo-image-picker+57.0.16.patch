+package expo.modules.imagepicker
+
+import expo.modules.kotlin.exception.CodedException
+import java.nio.ByteBuffer
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class CompleteVideoCopyTest {
+  @get:Rule val folder = TemporaryFolder()
+  private val ftyp = ByteBuffer.allocate(16).putInt(16).put("ftypisom".toByteArray()).putInt(0).array()
+  private fun mdat(size: Int) = ByteBuffer.allocate(12).putInt(size).put("mdat".toByteArray()).putInt(42).array()
+
+  @Test fun reopensProviderAfterShortRead() = runBlocking {
+    val cache = folder.newFile()
+    val full = ftyp + mdat(12)
+    var reads = 0
+    copyPickedVideo(cache) { cache.writeBytes(if (++reads == 1) full.copyOf(full.size - 2) else full) }
+    assertEquals(2, reads)
+    assertArrayEquals(full, cache.readBytes())
+  }
+
+  @Test fun rejectsPersistentShortReadsAndRemovesOnlyTheCacheCopy() {
+    val source = folder.newFile().apply { writeBytes(ftyp + mdat(4096)) }
+    val cache = folder.newFile()
+    var reads = 0
+    val error = assertThrows(CodedException::class.java) {
+      runBlocking { copyPickedVideo(cache) { reads++; source.copyTo(cache, overwrite = true) } }
+    }
+    assertEquals("ERR_INCOMPLETE_VIDEO", error.code)
+    assertEquals(2, reads)
+    assertFalse(cache.exists())
+    assertArrayEquals(ftyp + mdat(4096), source.readBytes())
+  }
+
+  @Test fun acceptsSupportedBoxSizesAndOtherContainersOnFirstRead() = runBlocking {
+    val extended = ByteBuffer.allocate(20).putInt(1).put("mdat".toByteArray()).putLong(20).putInt(42).array()
+    for (bytes in listOf(ftyp + mdat(12), ftyp + mdat(0), ftyp + extended, "other container".toByteArray())) {
+      val cache = folder.newFile()
+      var reads = 0
+      copyPickedVideo(cache) { reads++; cache.writeBytes(bytes) }
+      assertEquals(1, reads)
+      assertArrayEquals(bytes, cache.readBytes())
+    }
+  }
+}
