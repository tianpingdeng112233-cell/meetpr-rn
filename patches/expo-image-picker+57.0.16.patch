+package expo.modules.imagepicker
+
+import expo.modules.kotlin.exception.CodedException
+import java.io.File
+import java.io.RandomAccessFile
+
+/** The provider may return a short stream without throwing. Reopen it while we still have the grant. */
+internal suspend fun copyPickedVideo(target: File, copyFromProvider: suspend () -> Unit) {
+  var keepCopy = false
+  try {
+    repeat(2) {
+      copyFromProvider()
+      if (!isShortVideoCopy(target)) {
+        keepCopy = true
+        return
+      }
+    }
+    throw CodedException("ERR_INCOMPLETE_VIDEO", "Incomplete video file", null)
+  } finally {
+    if (!keepCopy) target.delete()
+  }
+}
+
+// Inspect box headers only. Unknown containers and open-ended boxes retain the platform's normal handling.
+private fun isShortVideoCopy(target: File): Boolean = RandomAccessFile(target, "r").use { file ->
+  val end = file.length()
+  if (end == 0L) return true
+  if (end < 8) return false
+  file.seek(4)
+  if (file.readInt() != 0x66747970) return false // ftyp
+  var position = 0L
+  // Bound seeks on highly fragmented or malformed files; leave inconclusive cases to the decoder.
+  repeat(8192) {
+    if (end - position < 8) return false
+    file.seek(position)
+    val size32 = file.readInt().toLong() and 0xffffffffL
+    val type = file.readInt()
+    if (size32 == 0L) return false // extends to EOF
+    val extended = size32 == 1L
+    if (extended && end - position < 16) return type == 0x6d646174
+    val size = if (extended) file.readLong() else size32
+    if (size < (if (extended) 16 else 8)) return false
+    if (size > end - position) return type == 0x6d646174 // mdat extends past EOF
+    position += size
+  }
+  false
+}
