{
  "expo": {
    "name": "MeetPR",
    "slug": "meetpr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meetpr",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.meetpr.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MeetPR needs access to the camera to record your training videos so your linked coach can review your technique and provide feedback.",
          "microphonePermission": "MeetPR needs access to the microphone to record sound while filming training videos (such as the barbell landing and voice cues) for your coach to review.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MeetPR needs access to your photo library so you can choose recorded training videos to upload to your coach.",
          "savePhotosPermission": "MeetPR adds recorded or badged export videos to Photos so you can keep and share your training records.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-notifications",
      [
        "react-native-video",
        {
          "enableNotificationControls": false,
          "enableBackgroundAudio": false
        }
      ],
      "react-native-compressor",
      [
        "expo-image-picker",
        {
          "photosPermission": "MeetPR needs access to your photo library so you can choose recorded training videos to upload to your coach.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
